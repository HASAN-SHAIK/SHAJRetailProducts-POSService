POS_ENVIRONMENT=production
POS_LISTEN_ADDRESS=127.0.0.1:4782
POS_SQLITE_PATH=/var/lib/shajretail-pos/shajretail-pos.db
POS_LOCAL_TOKEN_FILE=/var/lib/shajretail-pos/shajretail-pos.db.token
POS_BACKUP_DIRECTORY=/var/backups/shajretail-pos
POS_BACKUP_INTERVAL=6h
POS_BACKUP_RETENTION=14
POS_SYNC_REQUEST_TIMEOUT=10s
POS_SYNC_INTERVAL=2s
POS_OBSERVABILITY_INTERVAL=30s
# Central signs offline grants with its private key. Configure ONLY the matching public key here.
POS_OFFLINE_GRANT_PUBLIC_KEY=
# Configure all three central sync values together when Central sync is enabled:
POS_CENTRAL_API_URL=
POS_SYNC_TENANT_ID=
POS_SYNC_TOKEN=
# Restrict browser origins to the installed Frontend origins.
POS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
