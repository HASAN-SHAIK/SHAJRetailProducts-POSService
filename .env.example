# ========================================
# Runtime
# ========================================
POS_ENVIRONMENT=development
POS_LISTEN_ADDRESS=127.0.0.1:4782

# ========================================
# Local Persistence
# ========================================
POS_SQLITE_PATH=./data/shajretail-pos.db

# ========================================
# Local API Authentication
# ========================================
POS_LOCAL_API_TOKEN=change-me-in-development
POS_LOCAL_TOKEN_FILE=./data/shajretail-pos.db.token
POS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# ========================================
# Central Sync
# ========================================
POS_CENTRAL_API_URL=http://localhost:5001
POS_SYNC_TENANT_ID=tenant-dev
POS_SYNC_TOKEN=change-me
POS_SYNC_INTERVAL=2s
POS_SYNC_REQUEST_TIMEOUT=10s

# ========================================
# Backup and Observability
# ========================================
POS_BACKUP_DIRECTORY=./data/backups
POS_BACKUP_INTERVAL=6h
POS_BACKUP_RETENTION=14
POS_OBSERVABILITY_INTERVAL=30s
